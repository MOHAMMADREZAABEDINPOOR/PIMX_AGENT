# Public canonical URL. Use http://localhost:3000 for local development.
APP_URL=https://pimxagent.pages.dev
# Private server settings; never use NEXT_PUBLIC_ for these values.
APP_RUNTIME=cloudflare
APP_SURFACE=site
APP_DATA_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
APP_PROXY_SECRET=
TRUST_PROXY=true
# This Turnstile site key is intentionally public. Set before building.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# For local Next development use APP_URL=http://localhost:3000 and omit APP_RUNTIME.
