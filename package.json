{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "start": "next start",
    "deploy": "wrangler pages deploy .pages-output --project-name pimxagent",
