    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.553.0",
    "mammoth": "^1.12.3",
    "motion": "^12.23.24",
    "next": "^16.3.4",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "postcss": "^8.5.6",
    "pptxgenjs": "^4.0.1",
